# KIIT IEEE Event Platform - Environment Configuration
# Copy this file to .env or .env.local and populate with your credentials.

# Google Gemini API Key (Required for AI Event Generator & Copilot)
# Get your key from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Google Gemini Model Name (Optional, defaults to gemini-2.5-flash)
# Supported options: gemini-2.5-flash, gemini-1.5-flash, gemini-2.0-flash
GEMINI_MODEL=gemini-2.5-flash
